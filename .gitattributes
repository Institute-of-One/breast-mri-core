# supplementary_data_s1/ must stay byte-identical to the manuscript's Supplementary Data S1,
# whose sha256.json lists every file. No line-ending conversion, on any platform.
supplementary_data_s1/** -text

# The frozen plans, cohort list and lock files are pinned by sha256: the lock
# records the digest of the plan document, and the analysis refuses to run if
# the plan has moved since the freeze. Git's line-ending conversion would
# change those digests on checkout, so a fresh clone could never verify a
# freeze it is published to let people verify.
docs/** -text
